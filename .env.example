# Copy this file to .env and fill in your values
# Backend environment variables (used in server/)

PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/foodbridge
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
CLIENT_URL=http://localhost:5173

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend environment variables (used in client/)
# These go in client/.env
VITE_API_BASE_URL=http://localhost:5001/api/v1

