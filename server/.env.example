# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String:
# Option A - Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/foodbridge
# Option B - MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.abcde.mongodb.net/foodbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/foodbridge

# Authentication
JWT_SECRET=super_secret_foodbridge_jwt_token_key_change_in_production_1234567890

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary (Optional image hosting for surplus food listings)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=demo_cloudinary_secret_key
